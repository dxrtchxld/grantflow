# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=AIzaSy_REPLACE_ME
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:REPLACE_ME

# ── Mistral AI ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=REPLACE_ME

# ── Stripe (publishable key only — secret key stays on the server) ────────────
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Backend (your Cloud Function / Express server URL) ───────────────────────
# Used by plaidService.js and stripeAtlas.js for secret-key operations
BACKEND_URL=https://your-backend.example.com
